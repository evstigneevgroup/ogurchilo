[Unit]
Description=Ogurchilo promo bot
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ogurchilo-bot
ExecStart=/usr/bin/python3 /opt/ogurchilo-bot/bot.py
Restart=always
RestartSec=5
User=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
